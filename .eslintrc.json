{
	"root": true,
	"extends": [
		"next",
		"next/core-web-vitals",
		"prettier",
		"eslint:recommended",
		"plugin:jsx-a11y/recommended",
		"plugin:react/recommended"
	],
	"rules": {
		"react/jsx-sort-props": [
			1,
			{
				"callbacksLast": true,
				"shorthandFirst": false,
				"shorthandLast": true,
				"ignoreCase": true,
				"noSortAlphabetically": false,
				"reservedFirst": true
			}
		]
	}
}
